<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.minipaintdex</groupId>
  <artifactId>minipaintdex-parent</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MiniPaintDex</name>

  <modules>
    <module>backend/domain</module>
    <module>backend/application</module>
    <module>backend/adapter-file</module>
    <module>backend/server</module>
    <module>backend/cli</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <picocli.version>4.7.7</picocli.version>
    <frontend-maven-plugin.version>2.0.1</frontend-maven-plugin.version>
    <node.version>v24.11.1</node.version>
    <pnpm.version>11.19.0</pnpm.version>
    <frontend.skip>false</frontend.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.16,4)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>${frontend-maven-plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
          <installDirectory>${project.build.directory}/frontend</installDirectory>
          <skip>${frontend.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-pnpm</id>
            <phase>generate-resources</phase>
            <goals><goal>install-node-and-pnpm</goal></goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
              <pnpmVersion>${pnpm.version}</pnpmVersion>
            </configuration>
          </execution>
          <execution>
            <id>pnpm-install</id>
            <phase>generate-resources</phase>
            <goals><goal>pnpm</goal></goals>
            <configuration><arguments>install --frozen-lockfile</arguments></configuration>
          </execution>
          <execution>
            <id>frontend-check</id>
            <phase>verify</phase>
            <goals><goal>pnpm</goal></goals>
            <configuration><arguments>run check:web</arguments></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
