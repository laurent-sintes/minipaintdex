{
  "name": "minipaintdex-frontend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader native --host 127.0.0.1",
    "build": "vite build --config vite.config.ts --configLoader native",
    "lint": "oxlint src vite.config.ts",
    "test:web": "node --test --test-isolation=none --experimental-strip-types src/utils/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:catalogs": "node scripts/validate-catalogs.mjs",
    "check": "pnpm run check:web",
    "check:web": "pnpm run validate:catalogs && pnpm run lint && pnpm run typecheck && pnpm run test:web && pnpm run build",
    "format": "oxfmt"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
