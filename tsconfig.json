{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "spa/**/*.ts",
    "spa/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/paint-model.ts",
    "lib/project-model.ts",
    "lib/site-config-model.ts",
    "lib/shopping-data.ts",
    "lib/utils.ts",
    "vite.spa.config.ts"
  ],
  "exclude": ["node_modules", "backend", "app", "lib/catalog.ts"]
}
