<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.minipaintdex</groupId><artifactId>minipaintdex-parent</artifactId><version>0.2.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>minipaintdex-server</artifactId>
  <name>MiniPaintDex REST Server</name>
  <properties>
    <jacoco.line.minimum>0.40</jacoco.line.minimum>
    <jacoco.branch.minimum>0.25</jacoco.branch.minimum>
  </properties>
  <dependencies>
    <dependency><groupId>com.minipaintdex</groupId><artifactId>minipaintdex-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.minipaintdex</groupId><artifactId>minipaintdex-bootstrap</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-hateoas</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.data</groupId><artifactId>spring-data-commons</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>${maven.multiModuleProjectDirectory}/config</directory></resource>
      <resource><directory>${maven.multiModuleProjectDirectory}/docs</directory><targetPath>documentation</targetPath></resource>
      <resource><directory>${maven.multiModuleProjectDirectory}/target/frontend</directory><targetPath>static</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
        <executions><execution>
          <id>local-runtime-classpath</id><phase>process-classes</phase><goals><goal>build-classpath</goal></goals>
          <configuration>
            <includeScope>runtime</includeScope>
            <excludeGroupIds>com.minipaintdex</excludeGroupIds>
            <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
          </configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
        <executions><execution><goals><goal>build-info</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
